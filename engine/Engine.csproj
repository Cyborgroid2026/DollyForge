<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DollyForge</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>dolly-engine</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Silk.NET.OpenGL" Version="2.21.0" />
    <PackageReference Include="Silk.NET.Windowing.Glfw" Version="2.21.0" />
    <PackageReference Include="Silk.NET.Windowing.Sdl" Version="2.21.0" />
    <PackageReference Include="Silk.NET.Input.Glfw" Version="2.21.0" />
    <!-- 취약점은 이미지 디코딩 경로에만 해당: 우리는 인코딩(JPEG 스트리밍)만 사용 -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.10" NoWarn="NU1902;NU1903" />
  </ItemGroup>
  <ItemGroup>
    <!-- 파노라마 배경 (N 키): 실행 폴더의 assets/panoramas 에서 읽는다 -->
    <Content Include="assets/panoramas/*.jpg;assets/panoramas/*.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- 레퍼런스 피팅 결과 체형 (CyborgBody 가 읽는다) -->
    <Content Include="assets/body/*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- MakeHuman CC0 인체 자산 (tools/fetch-makehuman.sh 로 받음, git 제외) -->
    <Content Include="assets/makehuman/**/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../godot/src/Core/Cyborg.cs" />
    <Compile Include="../godot/src/Core/Blueprints.cs" />
    <Compile Include="../godot/src/Core/Catalog.cs" />
    <Compile Include="../godot/src/Core/Assembly.cs" />
    <Compile Include="../godot/src/Core/Physical.cs" />
    <Compile Include="../godot/src/Core/Parametric.cs" />
    <Compile Include="../godot/src/Core/Rules.cs" />
    <Compile Include="../godot/src/Core/Serialization.cs" />
    <Compile Include="../godot/src/Core/Export.cs" />
    <Compile Include="../godot/src/Core/Net/Protocol.cs" />
    <Compile Include="../godot/src/Core/Net/WorldClient.cs" />
  </ItemGroup>
</Project>
