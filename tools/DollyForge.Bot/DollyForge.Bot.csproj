<Project Sdk="Microsoft.NET.Sdk">

  <!--
    월드 서버 통합 시험 클라이언트. Godot 게임과 같은 공용 코어(godot/src/Core: 카탈로그·가격·기기 JSON·프로토콜)를 쓴다.
    사용법: dotnet run 뒤에 서버 주소 (기본 ws://127.0.0.1:7700). 서버는 DOLLY_DEV_ECHO_CODE=1 로 실행한다.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../godot/src/Core/**/*.cs" Link="Core/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
