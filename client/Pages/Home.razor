@page "/"
@implements IDisposable
@inject GameSession Game

<PageTitle>Dolly Forge</PageTitle>

<div id="viewport"></div>

@if (Game.Step == LoginStep.InGame)
{
    <Hud Game="Game" />
    <ChatBox Game="Game" />
}
else
{
    <LoginPanel Game="Game" />
}

@if (Game.Ending is not null)
{
    <EndingPanel Game="Game" />
}

@code {
    protected override void OnInitialized() => Game.Changed += Refresh;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await Game.StartAsync("viewport");
    }

    private void Refresh() => InvokeAsync(StateHasChanged);

    public void Dispose() => Game.Changed -= Refresh;
}
