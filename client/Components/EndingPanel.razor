@if (Game.Ending is { } e)
{
    <div class="ending @(e.Eternal ? "eternal" : "mortal")">
        <div class="ending-card">
            <div class="ending-kicker">ENDING</div>
            <h1>@e.Title</h1>
            @foreach (var para in e.Text.Split('\n', StringSplitOptions.RemoveEmptyEntries))
            {
                <p>@para</p>
            }
            <button class="primary" @onclick="Game.Restart">새로운 여정 시작</button>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public GameSession Game { get; set; } = default!;
}
